# 复制为 .env 后按需修改。不要提交真实密钥或账号信息。

APP_ENV=development
SAFE_MODE=true
SAFE_MODE_ALLOW_COUPONS=false
SAFE_MODE_ALLOW_CART=false
MAX_RETRIES=3
MAX_LLM_CALLS=3
MAX_WORKFLOW_STEPS=20

# 离线开发默认使用 fake。兼容服务可选择 openai-compatible 或 anthropic-compatible。
LLM_PROVIDER=fake
AGENT_MIN_CONFIDENCE=0.6
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=

# polling 是保留基线；event 使用后端事件队列和 WebSocket ingress。
TRANSPORT_MODE=polling
EVENT_STABILIZATION_MS=25

# 本地设备桥接可选共享令牌；非空时 Android 与后端必须保持一致。
DEVICE_SHARED_TOKEN=
MAX_TRANSPORT_MESSAGE_CHARS=1000000

# 单体本地会话存储：development 默认 SQLite；测试可设置 memory。
SESSION_STORE_BACKEND=sqlite
SESSION_STORE_PATH=data/device_sessions.sqlite3
SESSION_MAX_QUEUE_SIZE=32
SESSION_LEASE_TIMEOUT_SECONDS=30
SESSION_DEVICE_TIMEOUT_SECONDS=60
SESSION_MAX_LEASE_RETRIES=3
